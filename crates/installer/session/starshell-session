#!/bin/sh

if [ -n "$SHELL" ] &&
   grep -q "$SHELL" /etc/shells &&
   ! (echo "$SHELL" | grep -q "false") &&
   ! (echo "$SHELL" | grep -q "nologin"); then
  if [ "$1" != '-l' ]; then
    exec "$SHELL" -l -c "exec $0 -l $*"
  else
    shift
  fi
fi

if ! hash systemctl >/dev/null 2>&1; then
    echo "Starshell sessions need systemd; run niri --session instead."
    exit 1
fi

if systemctl --user -q is-active niri.service; then
    echo "A niri session is already running."
    exit 1
fi

XDG_CURRENT_DESKTOP=starshell:niri
XDG_SESSION_DESKTOP=starshell
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP

systemctl --user reset-failed
systemctl --user import-environment
if hash dbus-update-activation-environment 2>/dev/null; then
    dbus-update-activation-environment --all
fi

systemctl --user --wait start starshell-session.target

systemctl --user start --job-mode=replace-irreversibly niri-shutdown.target
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP NIRI_SOCKET
